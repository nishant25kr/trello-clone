generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String       @id @unique @default(uuid())
  username    String       @unique
  password    String
  memberships Membership[]
}

model Organization {
  id          String       @id @unique @default(uuid())
  name        String
  description String
  boards      Board[]
  memberships Membership[]
}

model Membership {
  id             String       @id @unique @default(uuid())
  userId         String
  organisationId String
  role           RoleEnum
  organisation   Organization @relation(fields: [organisationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])
}

model Board {
  id             String       @id @unique @default(uuid())
  title          String
  organisationId String
  organisation   Organization @relation(fields: [organisationId], references: [id])
  issues         Issue[]
  sections       Section[]
  repositories    Repository[]
}

model Issue {
  id          String  @id @unique @default(uuid())
  title       String
  description String
  boardId     String
  sectionId   String
  board       Board   @relation(fields: [boardId], references: [id])
  section     Section @relation(fields: [sectionId], references: [id])
}

model Section {
  id      String  @id @unique @default(uuid())
  title   String
  boardId String
  issues  Issue[]
  board   Board   @relation(fields: [boardId], references: [id])
}

model Repository {
  id           String   @id @default(cuid())
  githubId     String
  owner        String
  name         String
  defaultBranch String
  boardId      String
  board        Board    @relation(fields: [boardId], references: [id])
}

model AgentJob {
  id          String   @id @default(cuid())
  taskId      String
  status      String
  branchName  String?
  pullRequestUrl String?
  logs        String?
  createdAt   DateTime @default(now())
}

enum RoleEnum {
  ADMIN
  MEMBER
}

